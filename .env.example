DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/news
FETCH_INTERVAL_MINUTES=30
FETCH_ON_START=true
FETCH_BATCH_SIZE=100
MAX_NEWS_PER_STOCK=20
AUTO_SYNC_UNIVERSE=true
UNIVERSE_SYNC_HOUR=3
NEWS_LOOKBACK_DAYS=7
REQUEST_TIMEOUT_SECONDS=20
MAX_ARTICLE_BYTES=2000000
USER_AGENT=company-news-fetcher/1.0 (contact: you@example.com)
# 啟動時額外加入的自選股票；完整股票池會由官方來源自動同步
# 格式：市場:代號:公司名稱，以逗號分隔，可留空
STOCKS=TW:2330:台積電,TW:2317:鴻海,US:AAPL:Apple,US:MSFT:Microsoft
